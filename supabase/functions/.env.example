# ##########################################################################
# ###  NÃO coloque chaves aqui. Este arquivo vai para o GitHub. Use o .env  ###
# ##########################################################################
#
# MODELO dos secrets das Edge Functions no ambiente local.
# NÃO coloque chaves aqui: este arquivo vai para o git.
# Copie para supabase/functions/.env (esse sim fica fora do git), preencha lá
# e reinicie com: npx supabase stop && npx supabase start
#
# Na nuvem, configure os mesmos nomes em: Edge Functions → Secrets (veja o README).

# "gemini" usa a IA de verdade; "mock" devolve respostas de exemplo (sem gastar cota)
AI_PROVIDER=mock
GEMINI_API_KEY=
# modelo para análises e cartas ("-latest" acompanha a versão atual do Google)
GEMINI_MODEL=gemini-flash-latest,gemini-3-flash-preview
# modelo mais leve para tarefas simples (organizar seções)
GEMINI_MODEL_LITE=gemini-3.5-flash-lite,gemini-flash-lite-latest
# chamadas de IA por pessoa por dia
AI_DAILY_LIMIT=40

# busca de vagas (Etapa 9) — só fontes gratuitas (README, seção 6.2)
# real = fontes de verdade; mock = fontes que precisam de chave viram vagas de EXEMPLO; offline = só cache
JOBS_MODE=mock
# opcional (gratuitas, sem cartão): Jooble cobre Brasil e Portugal; Himalayas aumenta o limite
JOOBLE_API_KEY=
HIMALAYAS_API_KEY=
# segredo que o agendamento diário (pg_cron) envia para a função buscar-vagas
CRON_SECRET=
# Adzuna: DESLIGADA (não é gratuita). Deixe vazio.
ADZUNA_ENABLED=false
