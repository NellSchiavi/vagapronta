# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Estas variáveis são PÚBLICAS (vão para o navegador). Nunca coloque chaves secretas aqui.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Só para testar no celular pelo Wi-Fi (npm run dev:rede), com o Supabase local.
# "auto" = o celular fala com o Supabase pelo mesmo IP do PC que usou para abrir o app.
# No PC (localhost) nada muda. Pode apagar esta linha se não for testar no celular.
VITE_SUPABASE_URL_REDE=auto
